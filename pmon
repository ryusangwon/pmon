#!/bin/sh
pmon_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
interpreter=${PMON_PYTHON:-}
if [ -z "$interpreter" ]; then
    for candidate in python3.13 python3.12 python3.11 python3 python; do
        if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -B -c 'import sys; sys.exit(sys.version_info < (3,11))' 2>/dev/null; then
            interpreter=$candidate
            break
        fi
    done
fi
if [ -z "$interpreter" ]; then
    echo 'pmon requires Python 3.11+ (or set PMON_PYTHON).' >&2
    exit 1
fi
if [ -f "$pmon_root/pmon.toml" ]; then
    exec "$interpreter" -B "$pmon_root/src/pmon/_launch.py" --settings "$pmon_root/pmon.toml" "$@"
fi
exec "$interpreter" -B "$pmon_root/src/pmon/_launch.py" "$@"
